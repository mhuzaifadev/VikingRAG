# Application
VIKINGRAG_APP_NAME=vikingrag
VIKINGRAG_APP_ENV=development
VIKINGRAG_APP_DEBUG=false
VIKINGRAG_APP_LOG_LEVEL=INFO
VIKINGRAG_APP_HOST=0.0.0.0
VIKINGRAG_APP_PORT=8000

# Database (PostgreSQL + pgvector)
# Docker Compose Postgres: localhost:5432
# Local Homebrew postgresql@18 (if 15/16 already occupy 5432/5433): localhost:5434
VIKINGRAG_DATABASE_URL=postgresql+asyncpg://vikingrag:vikingrag@localhost:5432/vikingrag
VIKINGRAG_DATABASE_POOL_SIZE=5
VIKINGRAG_DATABASE_MAX_OVERFLOW=10
VIKINGRAG_DATABASE_ECHO=false

# Redis
VIKINGRAG_REDIS_URL=redis://localhost:6379/0

# Object storage (local adapter for development)
VIKINGRAG_OBJECT_STORE_BACKEND=local
VIKINGRAG_OBJECT_STORE_LOCAL_ROOT=./data/object_store
# Future S3/MinIO (unused while backend=local)
VIKINGRAG_OBJECT_STORE_S3_ENDPOINT=http://localhost:9000
VIKINGRAG_OBJECT_STORE_S3_ACCESS_KEY=
VIKINGRAG_OBJECT_STORE_S3_SECRET_KEY=
VIKINGRAG_OBJECT_STORE_S3_BUCKET=vikingrag
VIKINGRAG_OBJECT_STORE_S3_REGION=us-east-1

# LLM (openai_compatible works with OpenAI, vLLM, local gateways)
# For offline/dev: provider=fake
VIKINGRAG_LLM_PROVIDER=fake
VIKINGRAG_LLM_MODEL=fake-summary-v1
VIKINGRAG_LLM_BASE_URL=https://api.openai.com/v1
VIKINGRAG_LLM_API_KEY=
VIKINGRAG_LLM_TIMEOUT_SECONDS=30
VIKINGRAG_LLM_MAX_RETRIES=2
VIKINGRAG_LLM_TEMPERATURE=0.2

# Embeddings (deterministic = offline reproducible; openai_compatible = paid/remote)
VIKINGRAG_EMBEDDING_PROVIDER=deterministic
VIKINGRAG_EMBEDDING_MODEL=deterministic-hash-v1
VIKINGRAG_EMBEDDING_BASE_URL=https://api.openai.com/v1
VIKINGRAG_EMBEDDING_API_KEY=
VIKINGRAG_EMBEDDING_DIMENSIONS=1536
VIKINGRAG_EMBEDDING_IDENTITY_VERSION=1
VIKINGRAG_EMBEDDING_TIMEOUT_SECONDS=30
VIKINGRAG_EMBEDDING_MAX_RETRIES=2
VIKINGRAG_EMBEDDING_BATCH_SIZE=32

# Retrieval / Search
VIKINGRAG_RETRIEVAL_INITIAL_TOP_K=8
VIKINGRAG_RETRIEVAL_CANDIDATE_POOL_SIZE=30
VIKINGRAG_RETRIEVAL_MAX_ROUNDS=6
VIKINGRAG_RETRIEVAL_MAX_TOOL_CALLS=12
VIKINGRAG_RETRIEVAL_MAX_READ_TOKENS=12000
VIKINGRAG_RETRIEVAL_MAX_WALL_TIME_MS=12000
VIKINGRAG_RETRIEVAL_WEIGHT_DOCUMENT=0.85
VIKINGRAG_RETRIEVAL_WEIGHT_SECTION=1.0
VIKINGRAG_RETRIEVAL_WEIGHT_SUBSECTION=1.0
VIKINGRAG_RETRIEVAL_WEIGHT_CHUNK=1.0
VIKINGRAG_RETRIEVAL_RERANK_ENABLED=false

# Indexing
VIKINGRAG_INDEXING_SUMMARY_CONCURRENCY=4
VIKINGRAG_INDEXING_SUMMARY_MAX_INPUT_TOKENS=2000
VIKINGRAG_INDEXING_SUMMARY_MAX_OUTPUT_TOKENS=256
VIKINGRAG_INDEXING_SUMMARY_VERSION=1

# Ingestion / chunking
VIKINGRAG_INGESTION_DEFAULT_STRATEGY=skip_identical
VIKINGRAG_INGESTION_CHUNK_TARGET_TOKENS=650
VIKINGRAG_INGESTION_CHUNK_MAX_TOKENS=900
VIKINGRAG_INGESTION_CHUNK_OVERLAP_TOKENS=80
VIKINGRAG_INGESTION_MAX_UPLOAD_BYTES=20000000
